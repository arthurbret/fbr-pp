# Copier ce fichier en .env (ou définir ces variables dans Coolify).
# Chaque mode est actif par défaut ; mettre "false" pour le désactiver.
# Si un seul mode reste actif, le sélecteur Cloud / Local n'est plus affiché.
# Au moins un des deux doit rester actif.

# Détourage sur le serveur (POST /api/remove-background).
ENABLE_CLOUD_PROCESSING=true

# Détourage dans le navigateur, la photo ne quitte pas l'appareil.
ENABLE_LOCAL_PROCESSING=true
